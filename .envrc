# direnv: project-scoped Java + Python environment for Impulse.
# Loaded only when you cd into this directory. Does not pollute global PATH.
#
# Setup (one-time): direnv allow

# Java — required by PySpark (Spark 4.0 needs JDK 17 or 21).
# Installed via Homebrew as keg-only so it is NOT on the global PATH by default.
export JAVA_HOME="$(brew --prefix openjdk@17)/libexec/openjdk.jdk/Contents/Home"
PATH_add "$JAVA_HOME/bin"

# Python — activate the uv-managed virtualenv so `python` and `pytest` resolve
# to this project's interpreter rather than system Python.
if [ -d "$PWD/.venv" ]; then
  source "$PWD/.venv/bin/activate"
fi

# PySpark Python interpreter — must match the venv to avoid worker mismatch.
export PYSPARK_PYTHON="$PWD/.venv/bin/python"
export PYSPARK_DRIVER_PYTHON="$PWD/.venv/bin/python"
